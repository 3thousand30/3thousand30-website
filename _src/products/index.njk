---
layout: layouts/base.njk
permalink: products/index.html
title: Buy-Once Windows Tools for AI, Images, PDFs, and Files | 3thousand30
description: Search and filter 3thousand30’s buy-once Windows tools for AI creation, image preparation, translation, local PDF workflows, and file organisation.
pageType: catalog
analyticsPageType: product_index
catalogKind: products
---
{% from "components/cards.njk" import productCard %}
{% set toolProducts = products | productsForCollection('products') %}

<section class="site-shell py-12 sm:py-16">
  <nav class="mb-8 text-[11px] text-gray-600" aria-label="Breadcrumb"><a href="/" class="hover:text-retro-green">home</a> / <span class="text-gray-400">products</span></nav>
  <div class="max-w-4xl">
    <p class="eyebrow mb-4">{{ toolProducts.length }} tools</p>
    <h1 class="text-4xl font-light leading-tight text-white sm:text-6xl">Find the smallest tool that completes the job.</h1>
    <p class="mt-6 max-w-3xl text-base leading-8 text-gray-400">Browse AI creation, image preparation, translation, local PDF, and file tools. Looking for play instead? <a href="/games/" class="text-link">Browse games →</a></p>
  </div>
</section>

<section class="site-shell pb-20" data-filter-catalog>
  <div class="z-30 -mx-2 mb-8 border-y border-white/10 bg-black/95 px-2 py-5 backdrop-blur lg:sticky lg:top-16" data-catalog-controls>
    <div class="grid gap-4 lg:grid-cols-[minmax(240px,1fr)_minmax(180px,.65fr)_minmax(180px,.65fr)] lg:items-end">
      <div>
        <label for="product-search" class="mb-2 block text-[11px] uppercase tracking-[0.14em] text-gray-500">Search products</label>
        <input id="product-search" type="search" class="min-h-11 w-full border border-white/20 bg-black px-4 text-sm text-white placeholder:text-gray-700 focus:border-retro-green" placeholder="PDF, images, writing…" data-catalog-search>
      </div>
      <div>
        <label for="product-kind" class="mb-2 block text-[11px] uppercase tracking-[0.14em] text-gray-500">Product type</label>
        <select id="product-kind" class="filter-select" data-filter-group="kind">
          <option value="all">All products</option>
          <option value="ai">AI creation</option>
          <option value="utility">Local utilities</option>
        </select>
      </div>
      <div>
        <label for="product-task" class="mb-2 block text-[11px] uppercase tracking-[0.14em] text-gray-500">Focus</label>
        <select id="product-task" class="filter-select" data-filter-group="categories">
          <option value="all">Any focus</option>
          <option value="pdf">PDF</option>
          <option value="images">Images</option>
          <option value="writing">Writing</option>
          <option value="translation">Translation</option>
          <option value="files">Files</option>
        </select>
      </div>
    </div>
    <p class="mt-4 text-[11px] text-gray-600" data-result-count aria-live="polite">{{ toolProducts.length }} results</p>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {% for item in toolProducts %}{{ productCard(item) }}{% endfor %}
  </div>
  <div class="panel mt-8 p-8 text-center" data-empty-state hidden>
    <p class="text-sm text-gray-400">No product matches those filters.</p>
    <p class="mt-2 text-xs text-gray-600">Clear the search or choose a broader task.</p>
  </div>
</section>
