{% macro productCard(item, useCaseCount=0) %}
<article class="catalog-card reveal-item" data-reveal data-catalog-item data-kind="{{ item.type }}" data-categories="{{ item.categories | join(' ') }}" data-search="{{ item.name }} {{ item.description }} {{ item.typeLabel }} {{ item.categories | join(' ') }}">
  <div class="mb-5 flex items-start justify-between gap-4">
    <img src="{{ item.logo }}" alt="{{ item.name }} logo" class="h-14 w-14 rounded-xl object-cover" width="56" height="56" loading="lazy" decoding="async">
    <span class="tag text-retro-green">released</span>
  </div>
  <p class="eyebrow mb-2">{{ item.typeLabel }}</p>
  <h3 class="text-lg font-light text-white">{{ item.name }}</h3>
  <p class="mt-3 flex-1 text-xs leading-6 text-gray-500">{{ item.description }}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {% for category in item.categories %}<span class="tag">{{ category }}</span>{% endfor %}
  </div>
  <div class="mt-5 flex items-center justify-between gap-4 border-t border-white/10 pt-4 text-xs">
    <span class="text-retro-amber">{{ item.priceLabel }}</span>
    <a href="{{ item.url }}" class="after:absolute after:inset-0 text-retro-green" data-analytics-event="product_click" data-analytics-name="{{ item.name }}">view app →</a>
  </div>
</article>
{% endmacro %}

{% macro useCaseCard(item) %}
<article class="catalog-card reveal-item" data-reveal data-catalog-item data-kind="{{ item.category }}" data-categories="{{ item.products | join(' ') | lower }}" data-search="{{ item.title }} {{ item.summary }} {{ item.categoryLabel }} {{ item.products | join(' ') }}">
  <div class="mb-4 flex items-start justify-between gap-3">
    <p class="eyebrow">{{ item.categoryLabel }}</p>
    <span class="text-[10px] text-gray-700">UC-{{ item.id }}</span>
  </div>
  <h3 class="text-lg font-light leading-7 text-white">{{ item.title }}</h3>
  <p class="mt-3 flex-1 text-xs leading-6 text-gray-500">{{ item.summary }}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {% for code in item.products %}<span class="tag">{{ code }}</span>{% endfor %}
  </div>
  <div class="mt-5 border-t border-white/10 pt-4 text-right text-xs">
    <a href="{{ item.url }}" class="after:absolute after:inset-0 text-retro-green" data-analytics-event="use_case_click" data-analytics-name="{{ item.title }}">open workflow →</a>
  </div>
</article>
{% endmacro %}
