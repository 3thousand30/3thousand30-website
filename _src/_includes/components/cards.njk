{% macro productCard(item, useCaseCount=0) %}
<article class="catalog-card reveal-item" data-reveal data-catalog-item data-kind="{{ item.type }}" data-categories="{{ item.categories | join(' ') }}" data-search="{{ item.name }} {{ item.description }} {{ item.typeLabel }} {{ item.categories | join(' ') }}">
  <div class="card-address">
    <span class="card-identity"><span class="card-kind {% if item.type == 'game' %}card-kind--game{% else %}card-kind--tool{% endif %}"><img src="{% if item.type == 'game' %}/Logos/category-game.svg{% else %}/Logos/category-tool.svg{% endif %}" class="card-kind-icon" alt="" aria-hidden="true">{% if item.type == 'game' %}game{% else %}tool{% endif %}</span><span>app://{{ item.code | lower }}</span></span>
    <span class="card-price">
      {% if item.price.discountPercent > 0 %}
      <span class="sr-only">US Store price ${{ item.price.current }}, {{ item.price.discountPercent }}% off the original ${{ item.price.original }}</span>
      <span class="card-discount" aria-hidden="true">-{{ item.price.discountPercent }}%</span>
      <span class="card-price-values" aria-hidden="true"><s>${{ item.price.original }}</s><strong>${{ item.price.current }}</strong></span>
      {% else %}
      <span class="sr-only">Recommended US Store price ${{ item.price.current }}</span>
      <span class="card-price-values" aria-hidden="true"><strong>${{ item.price.current }}</strong></span>
      {% endif %}
    </span>
  </div>
  <div class="mb-4 mt-5 flex items-start gap-4">
    <img src="{{ item.logo }}" alt="{{ item.name }} logo" class="product-mark" width="56" height="56" loading="lazy" decoding="async">
    <div class="min-w-0 pt-0.5">
      <p class="eyebrow mb-2">{{ item.typeLabel }}</p>
      <h3 class="text-base font-normal leading-6 text-white">{{ item.name }}</h3>
    </div>
  </div>
  <p class="mt-3 flex-1 text-xs leading-6 text-gray-500">{{ item.description }}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {% for category in item.categories %}<span class="tag">{{ category }}</span>{% endfor %}
  </div>
  <div class="mt-5 flex items-center justify-between gap-4 border-t border-white/10 pt-4 text-xs">
    <span class="card-license"><i>//</i> buy once</span>
    <a href="{{ item.url }}" class="after:absolute after:inset-0 text-retro-green" data-analytics-event="product_click" data-analytics-name="{{ item.name }}">view app →</a>
  </div>
</article>
{% endmacro %}

{% macro useCaseCard(item) %}
<article class="catalog-card reveal-item" data-reveal data-catalog-item data-kind="{{ item.category }}" data-categories="{{ item.products | join(' ') | lower }} {{ item.productGroups | join(' ') }}" data-search="{{ item.title }} {{ item.summary }} {{ item.categoryLabel }} {{ item.products | join(' ') }}">
  <div class="card-address">
    <span>workflow://UC-{{ item.id }}</span>
    <span class="card-status"><i aria-hidden="true"></i>{{ item.steps.length }} steps</span>
  </div>
  <p class="eyebrow mb-2 mt-5">{{ item.categoryLabel }}</p>
  <h3 class="text-base font-normal leading-7 text-white">{{ item.title }}</h3>
  <p class="mt-3 flex-1 text-xs leading-6 text-gray-500">{{ item.summary }}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {% for code in item.products %}<span class="tag">{{ code }}</span>{% endfor %}
  </div>
  <div class="mt-5 border-t border-white/10 pt-4 text-right text-xs">
    <a href="{{ item.url }}" class="after:absolute after:inset-0 text-retro-green" data-analytics-event="use_case_click" data-analytics-name="{{ item.title }}">open workflow →</a>
  </div>
</article>
{% endmacro %}
