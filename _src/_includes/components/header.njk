    </a>

    <nav class="hidden items-center gap-5 lg:flex" aria-label="Primary navigation">
      <a href="/products/" class="text-xs transition-colors hover:text-retro-green {% if catalogKind == 'products' or (pageType == 'product' and product.type != 'game') %}text-retro-green{% else %}text-gray-400{% endif %}"{% if catalogKind == 'products' or (pageType == 'product' and product.type != 'game') %} aria-current="page"{% endif %}><span aria-hidden="true">./</span>products</a>
      <a href="/games/" class="text-xs transition-colors hover:text-retro-green {% if catalogKind == 'games' or (pageType == 'product' and product.type == 'game') %}text-retro-green{% else %}text-gray-400{% endif %}"{% if catalogKind == 'games' or (pageType == 'product' and product.type == 'game') %} aria-current="page"{% endif %}><span aria-hidden="true">./</span>games</a>
