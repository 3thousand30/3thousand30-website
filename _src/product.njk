---
layout: layouts/base.njk
pagination:
  data: products
  size: 1
  alias: product
permalink: "{{ product.slug }}.html"
pageType: product
eleventyComputed:
  title: "{{ product.name }} for Windows — Buy Once | 3thousand30"
  description: "{{ product.description }}"
  image: "{{ product.logo }}"
  imageAlt: "{{ product.name }} logo"
---
{% from "components/cards.njk" import productCard, useCaseCard %}
{% set relatedProducts = products | filterByCodes(product.relatedProducts) %}
{% set relatedUseCases = useCases | filterBySlugs(product.relatedUseCases) %}

<section class="site-shell py-10 sm:py-14">
  <nav class="mb-8 text-[11px] text-gray-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-retro-green">home</a> /
    <a href="/products/" class="hover:text-retro-green">products</a> /
    <span class="text-gray-400">{{ product.shortName }}</span>
  </nav>

  <div class="grid gap-10 lg:grid-cols-[1fr_360px] lg:items-start">
    <div>
      <div class="mb-6 flex flex-wrap gap-2">
        <span class="tag text-retro-green">released</span>
        <span class="tag">{{ product.typeLabel }}</span>
        <span class="tag">Windows</span>
      </div>
      <h1 class="max-w-4xl text-4xl font-light leading-tight text-white sm:text-6xl">{{ product.name }}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-retro-green">{{ product.tagline }}</p>
      <p class="mt-5 max-w-3xl text-sm leading-7 text-gray-400">{{ product.intro }}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="{{ product.storeUrl }}" target="_blank" rel="noopener" class="button-primary" data-analytics-event="store_click" data-analytics-name="{{ product.name }} Microsoft Store">Microsoft Store →</a>
        {% if product.docsUrl %}<a href="{{ product.docsUrl }}" target="_blank" rel="noopener" class="button-secondary" data-analytics-event="outbound_click" data-analytics-name="{{ product.name }} documentation">documentation</a>{% endif %}
      </div>
    </div>

    <aside class="panel-green p-6 reveal-item" data-reveal aria-label="Product facts">
      <img src="{{ product.logo }}" alt="{{ product.name }} logo" class="h-24 w-24 rounded-2xl object-cover" width="96" height="96">
      <dl class="mt-6 space-y-5 text-xs">
        <div class="border-b border-white/10 pb-4">
          <dt class="text-gray-600">license</dt>
          <dd class="mt-1 text-retro-amber">{{ product.priceLabel }}</dd>
          <dd class="mt-2 leading-5 text-gray-600">{{ product.priceNote }}</dd>
        </div>
        <div class="border-b border-white/10 pb-4">
          <dt class="text-gray-600">privacy boundary</dt>
          <dd class="mt-1 text-retro-green">{{ product.privacyLabel }}</dd>
        </div>
        <div>
          <dt class="text-gray-600">product code</dt>
          <dd class="mt-1 text-white">{{ product.code }}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<section class="site-shell py-12 sm:py-16">
  <div class="mb-8">
    <p class="eyebrow mb-3">what_it_does</p>
    <h2 class="section-heading">A focused workflow, not a suite you have to rent.</h2>
  </div>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for feature in product.features %}
    <div class="panel p-5 reveal-item" data-reveal>
      <span class="text-retro-green" aria-hidden="true">›</span>
      <p class="mt-3 text-sm leading-6 text-gray-300">{{ feature }}</p>
    </div>
    {% endfor %}
  </div>
</section>

{% if product.screenshotItems.length %}
<section class="border-y border-white/10 bg-white/[0.015]">
  <div class="site-shell py-12 sm:py-16">
    <div class="mb-8">
      <p class="eyebrow mb-3">inside_the_app</p>
      <h2 class="section-heading">See the actual Windows workflow</h2>
    </div>
    <div class="grid gap-5 lg:grid-cols-2">
      {% for screenshot in product.screenshotItems %}
      <figure class="panel overflow-hidden reveal-item" data-reveal>
        <a href="{{ screenshot.src }}" target="_blank" rel="noopener" aria-label="Open full-size screenshot: {{ screenshot.alt }}">
          <img src="{{ screenshot.src }}" alt="{{ screenshot.alt }}" class="aspect-video w-full bg-[#090909] object-contain" loading="lazy" decoding="async">
        </a>
        <figcaption class="border-t border-white/10 p-4 text-xs leading-5 text-gray-500">{{ screenshot.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="site-shell grid gap-6 py-12 sm:py-16 lg:grid-cols-2">
  <div class="panel p-6 sm:p-8 reveal-item" data-reveal>
    <p class="eyebrow mb-4">who_it_is_for</p>
    <ul class="space-y-4 text-sm leading-6 text-gray-400">
      {% for audience in product.audiences %}<li class="flex gap-3"><span class="text-retro-green" aria-hidden="true">✓</span><span>{{ audience }}</span></li>{% endfor %}
    </ul>
  </div>
  <div class="panel-green p-6 sm:p-8 reveal-item" data-reveal>
    <p class="eyebrow mb-4">privacy_and_control</p>
    <h2 class="text-xl font-light text-white">{{ product.privacyLabel }}</h2>
    <p class="mt-4 text-sm leading-7 text-gray-400">{{ product.privacyText }}</p>
  </div>
</section>

{% if relatedUseCases.length %}
<section class="site-shell py-12 sm:py-16">
  <div class="mb-8 flex items-end justify-between gap-5">
    <div>
      <p class="eyebrow mb-3">use_it_for</p>
      <h2 class="section-heading">Practical workflows</h2>
    </div>
    <a href="/use-cases/" class="text-link text-xs">all use cases →</a>
  </div>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {% for item in relatedUseCases %}{{ useCaseCard(item) }}{% endfor %}
  </div>
</section>
{% endif %}

{% if product.faq.length %}
<section class="site-shell max-w-4xl py-12 sm:py-16">
  <p class="eyebrow mb-3">faq</p>
  <h2 class="section-heading mb-7">Straight answers</h2>
  <div class="space-y-3">
    {% for item in product.faq %}
    <details class="faq-item panel group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-5 p-5 text-sm text-white">
        <span>{{ item.q }}</span><span class="text-retro-green transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="border-t border-white/10 px-5 py-5 text-sm leading-7 text-gray-400">{{ item.a }}</p>
    </details>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="site-shell py-12 sm:py-16">
  <div class="panel-amber grid gap-7 p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
    <div>
      <p class="eyebrow mb-3 text-retro-amber">ready_when_you_are</p>
      <h2 class="text-2xl font-light text-white">Own {{ product.shortName }} and keep the workflow.</h2>
      <p class="mt-3 text-sm leading-6 text-gray-500">The Microsoft Store shows the current price for your region.</p>
    </div>
    <a href="{{ product.storeUrl }}" target="_blank" rel="noopener" class="button-primary" data-analytics-event="store_click" data-analytics-name="{{ product.name }} Microsoft Store bottom CTA">open Microsoft Store →</a>
  </div>
</section>

{% if relatedProducts.length %}
<section class="site-shell pb-10 pt-6">
  <p class="eyebrow mb-5">related_products</p>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {% for item in relatedProducts %}{{ productCard(item) }}{% endfor %}
  </div>
</section>
{% endif %}
